# Web local development only. Create apps/web/.env.local and keep it untracked.
DATABASE_URL=
REDIS_URL=

# Authentication and OAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web BFF -> local Agent. Both runtimes must use the same secret value.
AGENT_SERVER_URL=http://127.0.0.1:3101
AGENT_INTERNAL_SECRET=

# Web-side AI services. Agent models belong in apps/agent/.env.local.
AI_PROVIDER=custom
AI_SUMMARY_MODEL=
AI_CHAT_MODEL=
AI_TAG_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1536

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional reranking
AI_RERANK_PROVIDER=
AI_RERANK_MODEL=
AI_RERANK_API_KEY=
AI_RERANK_BASE_URL=
AI_RERANK_TIMEOUT_MS=
AI_RERANK_MAX_CANDIDATES=
JINA_API_KEY=

# Storage: configure Qiniu or R2 according to STORAGE_PROVIDER.
STORAGE_PROVIDER=qiniu
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_PUBLIC_BASE_URL=
QINIU_UPLOAD_ENDPOINT=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Email and optional feed discovery
RESEND_API_KEY=
EMAIL_FROM=
FEED_SEARCH_ENDPOINT=
FEED_SEARCH_API_KEY=

# Optional Web observability
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
