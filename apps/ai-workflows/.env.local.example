# AI Workflow local development only. Create apps/ai-workflows/.env.local.
NODE_ENV=development
DATABASE_URL=

AI_WORKFLOW_BATCH_LIMIT=1
AI_WORKFLOW_CONCURRENCY=1

# Keep the existing Workflow provider and models; Agent settings do not belong here.
AI_PROVIDER=
AI_MODEL_SUMMARY=
AI_MODEL_EMBEDDING=
AI_MODEL_RECOMMENDATION=
AI_MODEL_NOTE_INSIGHT=
AI_EMBEDDING_DIMENSIONS=1536

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional reranking
AI_RERANK_PROVIDER=
AI_RERANK_MODEL=
AI_RERANK_API_KEY=
AI_RERANK_BASE_URL=
AI_RERANK_TIMEOUT_MS=
AI_RERANK_MAX_CANDIDATES=
JINA_API_KEY=

# Configure all three keys or leave tracing disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_USER_HASH_SECRET=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_PROMPT_LABEL=development
LANGFUSE_RELEASE=local
LANGFUSE_SHUTDOWN_TIMEOUT_MS=3000

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
