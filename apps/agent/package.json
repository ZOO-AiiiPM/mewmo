{
  "name": "@mewmo/agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "cron:automations": "tsx src/commands/run-automations.ts",
    "build": "tsc -p tsconfig.json && cp -R prompts dist/prompts && cp -R evals dist/evals",
    "lint": "eslint .",
    "test": "vitest run src evals --exclude 'dist/**'",
    "eval:url-intent": "tsx evals/url-intent.live.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.0",
    "@earendil-works/pi-ai": "0.81.0",
    "@langfuse/otel": "5.9.1",
    "@langfuse/tracing": "5.9.1",
    "@mewmo/ai": "workspace:*",
    "@mewmo/application": "workspace:*",
    "@mewmo/content": "workspace:*",
    "@mewmo/shared": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "ai": "7.0.31",
    "fastify": "5.10.0",
    "jose": "6.2.3",
    "undici": "8.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.22.4"
  }
}
