# Agent local development only. Create apps/agent/.env.local and keep it untracked.
NODE_ENV=development
DATABASE_URL=

# Must equal AGENT_INTERNAL_SECRET in apps/web/.env.local.
AGENT_IDENTITY_SECRET=
AGENT_IDENTITY_ISSUER=mewmo-web
AGENT_IDENTITY_AUDIENCE=mewmo-agent
AGENT_HOST=127.0.0.1
AGENT_PORT=3101
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_MS=120000
AGENT_WORKER_ID=mewmo-agent-local
AGENT_TURN_LEASE_MS=120000
AGENT_AUTOMATION_BATCH_LIMIT=5
AGENT_AUTOMATION_LEASE_MS=300000

# ZOO-102 local Agent baseline. Workflow models do not belong in this file.
AI_PROVIDER=deepseek
AI_MODEL_AGENT_CHAT=deepseek-v4-flash
AI_MODEL_DEEP_INSIGHT=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternative providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional knowledge reranking and Web tools
AI_RERANK_PROVIDER=
AI_RERANK_MODEL=
AI_RERANK_API_KEY=
AI_RERANK_BASE_URL=
AI_RERANK_TIMEOUT_MS=
AI_RERANK_MAX_CANDIDATES=
JINA_API_KEY=
AGENT_WEB_TIMEOUT_MS=20000
AGENT_WEB_SEARCH_BUDGET=2
AGENT_WEB_FETCH_BUDGET=5
AGENT_WEB_CACHE_TTL_MS=300000
AGENT_WEB_CACHE_MAX_ENTRIES=128

# Configure both Langfuse keys or leave both empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=local
LANGFUSE_SHUTDOWN_TIMEOUT_MS=3000

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
